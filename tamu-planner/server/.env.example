# "development" → local JSON storage + optional dev auth bypass
# "production"  → Firestore storage + Firebase auth required
NODE_ENV=development

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# For multiple allowed origins, use comma-separated values:
# CLIENT_ORIGIN=https://degreeflow-3227a.web.app,https://degreeflow-3227a.firebaseapp.com
DATABASE_URL=postgresql://user:password@localhost:5432/degreeflow

# Path to local JSON DB file (only used when NODE_ENV != production)
LOCAL_DB_PATH=./data/local-db.json

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=replace_me

# Firebase credentials — required in production.
# In development, leave blank to use local storage + dev auth bypass,
# or fill in to use Firebase auth with local storage.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

TAMU_AI_CHAT_API_KEY=your_tamu_ai_api_key_here
TAMU_AI_CHAT_API_ENDPOINT=https://chat-api.tamu.ai
