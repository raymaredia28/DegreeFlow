{
  "name": "degreeflow-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "validate:data": "node scripts/validate-data.js",
    "test:unit": "node tests/evaluator.test.js && node --loader ts-node/esm tests/documentParsing.test.ts",
    "test": "npm run build && PORT=4000 CLIENT_ORIGIN=http://localhost:5173 NODE_ENV=development LOCAL_DB_PATH=/tmp/degreeflow-test-db.json TAMU_AI_CHAT_API_KEY=test-key node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "firebase-admin": "^13.6.1",
    "helmet": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
